# Discord Developer Portal で取得した bot トークン
DISCORD_TOKEN=your-bot-token

# 候補日を投稿するチャンネルの ID(チャンネル右クリック → ID をコピー)
CHANNEL_ID=123456789012345678

# 開催に必要な ⭕ の人数(デフォルト 5)
REQUIRED_COUNT=5

# 候補日を投稿する曜日: 0=月 1=火 2=水 3=木 4=金 5=土 6=日(デフォルト 0)
POST_WEEKDAY=0

# 投稿する時刻(JST・時のみ、デフォルト 12)
POST_HOUR=12

# 何日先まで候補日を出すか(デフォルト 7)
DAYS_AHEAD=7

# 開催時刻の表示(デフォルト 21:00)
GAME_TIME=21:00
